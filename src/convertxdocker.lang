# ===========================================================================
# Multilingual file for the TOS 7 Docker application "convertxdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "ConvertX"
auth         = "C4illin"
version      = "@@VERSION@@"
descript     = "ConvertX is a self-hosted file converter: convert images, documents, e-books, audio, video and data files between more than a thousand format combinations, using the converters bundled in the image (ImageMagick, ffmpeg, LibreOffice, Pandoc, Calibre, Inkscape and others). It supports batch conversion, multiple accounts and password protection. This package runs the upstream Docker Hub image as a non-root container and keeps its data in the application data folder on the NAS."
release_note = "0.20.0-2: upgraded to ConvertX 0.20.0 (latest upstream release); added the privacy policy (linked from Help) and a licence notice; fixed login over the NAS's plain-HTTP address (HTTP_ALLOWED) and closed registration after the first account; set a writable HOME so LibreOffice/Calibre conversions work as a non-root user; documented retention, user rights and the deletion channel; corrected the description. Rectified per review comments."
important    = "Open http://<NAS-IP>:8070/ on the LAN and create the first account immediately (registration closes after it), then log in. Cookies are allowed over plain HTTP so login works without HTTPS. Data and history stay in /Volume1/DockerAppData/convertxdocker/data; converted files are auto-deleted after 1 hour by default. Runs as uid 1000 with HOME=/home/convertx. Needs DockerEngine; use a registry mirror if Docker Hub is unreachable. No telemetry. Privacy policy: see the Help link."

[zh-cn]
name         = "ConvertX"
auth         = "C4illin"
version      = "@@VERSION@@"
descript     = "ConvertX 是一个自托管的文件转换器：用镜像内置的转换工具（ImageMagick、ffmpeg、LibreOffice、Pandoc、Calibre、Inkscape 等）在图片、文档、电子书、音视频和数据文件之间转换，支持一千多种格式组合、批量转换、多账号与密码保护。本应用以非 root 容器运行上游 Docker Hub 镜像，数据保存在 NAS 的应用数据目录中。"
release_note = "0.20.0-2：升级到上游最新版 ConvertX 0.20.0；新增隐私政策（帮助链接）与许可证声明；修复 NAS 上 HTTP 地址无法登录的问题（HTTP_ALLOWED），首个账号创建后关闭注册；为内置转换工具设置可写 HOME，使非 root 用户下 LibreOffice/Calibre 转换可用；写明数据保留期、用户权利与删除渠道；描述改为与实际功能一致。按审核意见整改。"
important    = "打开 http://<NAS-IP>:8070/ 并立即创建第一个账号（之后关闭注册），然后登录。允许在 HTTP 下使用 Cookie，因此没有 HTTPS 也能登录。数据与转换记录保存在 /Volume1/DockerAppData/convertxdocker/data；转换结果默认 1 小时后自动清理。容器以 uid 1000 运行并设置 HOME=/home/convertx。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。无遥测。隐私政策见帮助链接。"

[zh-hk]
name         = "ConvertX"
auth         = "C4illin"
version      = "@@VERSION@@"
descript     = "ConvertX 是一個自託管的檔案轉換器：用映像內建的轉換工具（ImageMagick、ffmpeg、LibreOffice、Pandoc、Calibre、Inkscape 等）在圖片、文件、電子書、影音與資料檔之間轉換，支援一千多種格式組合、批次轉換、多帳號與密碼保護。本應用以非 root 容器執行上游 Docker Hub 映像，資料保存在 NAS 的應用資料目錄中。"
release_note = "0.20.0-2：升級到上游最新版 ConvertX 0.20.0；新增隱私政策（說明連結）與授權聲明；修復 NAS 上 HTTP 位址無法登入的問題（HTTP_ALLOWED），第一個帳號建立後關閉註冊；為內建轉換工具設定可寫 HOME，使非 root 使用者下 LibreOffice/Calibre 轉換可用；寫明資料保留期、使用者權利與刪除管道；描述改為與實際功能一致。依審核意見整改。"
important    = "開啟 http://<NAS-IP>:8070/ 並立即建立第一個帳號（之後關閉註冊），然後登入。允許在 HTTP 下使用 Cookie，因此沒有 HTTPS 也能登入。資料與轉換記錄保存在 /Volume1/DockerAppData/convertxdocker/data；轉換結果預設 1 小時後自動清理。容器以 uid 1000 執行並設定 HOME=/home/convertx。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。無遙測。隱私政策見說明連結。"

