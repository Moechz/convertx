# ===========================================================================
# Multilingual file for the TOS 7 Docker application "convertxdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "ConvertX"
auth         = "C4illin"
version      = "@@VERSION@@"
descript     = "ConvertX is a self-hosted file converter: convert images, documents, e-books, audio, video and data files between more than a thousand format combinations, using the converters bundled in the image (ImageMagick, ffmpeg, LibreOffice, Pandoc, Calibre, Inkscape and others). It supports batch conversion, multiple accounts and password protection. This package runs the upstream Docker Hub image as a non-root container and keeps its data in the application data folder on the NAS."
release_note = "0.20.0-1: upgraded to ConvertX 0.20.0 (latest upstream release; security and converter fixes); added the privacy policy (linked from Help) and a licence notice; documented data retention, user rights and the deletion channel; set a writable HOME so the bundled converters (LibreOffice, Calibre) work for the non-root user; refreshed the icon; corrected the description to the features actually delivered. Rectified per review comments."
important    = "Open http://<NAS-IP>:8070/ and create the first account, then log in. Uploaded files and conversion history stay in /Volume1/DockerAppData/convertxdocker/data; the app deletes converted files after 1 hour by default. The container runs as uid 1000 with HOME=/home/convertx so the bundled converters work. Needs DockerEngine; use a registry mirror if Docker Hub is unreachable. No telemetry and no external requests besides the image pull. Privacy policy: see the Help link. Plain HTTP on the LAN."

[zh-cn]
name         = "ConvertX"
auth         = "C4illin"
version      = "@@VERSION@@"
descript     = "ConvertX 是一个自托管的文件转换器：用镜像内置的转换工具（ImageMagick、ffmpeg、LibreOffice、Pandoc、Calibre、Inkscape 等）在图片、文档、电子书、音视频和数据文件之间转换，支持一千多种格式组合、批量转换、多账号与密码保护。本应用以非 root 容器运行上游 Docker Hub 镜像，数据保存在 NAS 的应用数据目录中。"
release_note = "0.20.0-1：升级到上游最新版 ConvertX 0.20.0（含安全与转换修复）；新增隐私政策（帮助链接）与许可证声明，写明数据保留期、用户权利与删除渠道；为内置转换工具设置可写 HOME，使非 root 用户下 LibreOffice/Calibre 等转换可用；更新图标；描述改为与实际功能一致。按审核意见整改。"
important    = "打开 http://<NAS-IP>:8070/ 创建第一个账号并登录。上传的文件与转换记录保存在 /Volume1/DockerAppData/convertxdocker/data；转换结果会由应用自动清理（默认 1 小时后）。容器以 uid 1000 运行并设置 HOME=/home/convertx，内置转换工具可正常工作。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。无遥测，除拉取镜像外不访问外部网络。隐私政策见帮助链接。局域网内为 HTTP。"

[zh-hk]
name         = "ConvertX"
auth         = "C4illin"
version      = "@@VERSION@@"
descript     = "ConvertX 是一個自託管的檔案轉換器：用映像內建的轉換工具（ImageMagick、ffmpeg、LibreOffice、Pandoc、Calibre、Inkscape 等）在圖片、文件、電子書、影音與資料檔之間轉換，支援一千多種格式組合、批次轉換、多帳號與密碼保護。本應用以非 root 容器執行上游 Docker Hub 映像，資料保存在 NAS 的應用資料目錄中。"
release_note = "0.20.0-1：升級到上游最新版 ConvertX 0.20.0（含安全與轉換修正）；新增隱私政策（說明連結）與授權聲明，寫明資料保留期、使用者權利與刪除管道；為內建轉換工具設定可寫 HOME，使非 root 使用者下 LibreOffice/Calibre 等轉換可用；更新圖示；描述改為與實際功能一致。依審核意見整改。"
important    = "開啟 http://<NAS-IP>:8070/ 建立第一個帳號並登入。上傳的檔案與轉換記錄保存在 /Volume1/DockerAppData/convertxdocker/data；轉換結果會由應用自動清理（預設 1 小時後）。容器以 uid 1000 執行並設定 HOME=/home/convertx，內建轉換工具可正常運作。需要 DockerEngine；Docker Hub 不可達時先設定鏡像加速。無遙測，除拉取映像外不存取外部網路。隱私政策見說明連結。區域網路內為 HTTP。"

